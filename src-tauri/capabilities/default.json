{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Reson desktop capability",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://spotisaver.net/en"
        }
      ]
    },
    "window-state:default",
    "updater:default",
    "process:default"
  ]
}
